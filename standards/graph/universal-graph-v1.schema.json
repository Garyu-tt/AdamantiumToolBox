{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mechanicus Universal Graph IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "const": "mas.universal-graph.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "ports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
          },
          "kind": {
            "enum": [
              "capability",
              "composite",
              "neural_region",
              "resource",
              "device",
              "ui",
              "policy"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "ports": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "role",
                "datatype"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
                },
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "role": {
                  "enum": [
                    "data",
                    "control",
                    "event",
                    "neural",
                    "authority",
                    "dependency"
                  ]
                },
                "datatype": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{2,95}$"
                }
              }
            }
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract",
              "version"
            ],
            "properties": {
              "contract": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{2,95}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            }
          },
          "graphRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "binding"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "capability"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "graphRef"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "composite"
                }
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
          },
          "kind": {
            "enum": [
              "data",
              "control",
              "event",
              "neural",
              "authority",
              "dependency"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "port"
            ],
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
              },
              "port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "port"
            ],
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
              },
              "port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"
              }
            }
          },
          "feedback": {
            "const": true
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "feedback"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "enum": [
                    "neural",
                    "event"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "Structural JSON Schema only. Duplicate IDs, port compatibility, domain cycles, feedback, authorization, discovery and recursive references MUST be checked separately by validators/runtime."
}
