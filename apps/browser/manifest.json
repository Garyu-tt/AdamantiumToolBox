{
  "mas": "1.0",
  "id": "browser",
  "name": "Chromium Browser",
  "version": "0.1.0",
  "icon": "browser",
  "lifecycle": "independent",
  "service": {
    "protocol": "mas-http-1",
    "port": 8892,
    "invokeTimeoutMs": 12000
  },
  "ui": {
    "standard": "mas-ui-1",
    "mode": "embedded-and-standalone"
  },
  "auth": {
    "mode": "host-delegated"
  },
  "permissions": [
    "browser.read",
    "browser.navigate",
    "browser.interact"
  ],
  "events": {
    "schema": "mas-event-1"
  },
  "data": {
    "refs": "mas-ref-1"
  },
  "updates": {
    "strategy": "semver",
    "migrations": []
  }
}
