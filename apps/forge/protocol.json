{
 "schema":"mechanicus.forge.adapter.v6",
 "role":"stateless-contract-adapter",
 "rules":{
  "function_unit":"One independently invokable function per node",
  "invocation_unit":"One target function per request; revisits permitted",
  "publication":"External verification and committed capability/UI publication",
  "revisit":"Revision-triggered external invalidation and verification",
  "blockers":"External cause, evidence, impact, remedies, bounded attempts",
  "safe_failover":"Missing provider: docs/validation only; no implicit write failover",
  "ui_fallback":"Raw UI draft only; unverified actions cannot execute",
  "commit":"External CAS visibility commit; Forge emits recipes only",
  "invalidation":"External reverse-index lookup, UI revoke and revisit",
  "blocker_explanation":"Explicit cause, evidence, impact and remedies required",
  "provider_negotiation":"Untrusted snapshot matching; host must authorize",
  "events":"Untrusted ordered event projection; no cursor ownership",
  "integration":"External host dispatch intent, per-call reauthorization and CAS",
  "visibility":"Untrusted receipt coherence; host owns UI confirmation",
  "composite":"Recursive groups contain shared atomic function references",
  "shared_references":"Repeated UI mounts share one function and handler",
  "dependency_cycles":"Reject local cycles; flag unresolved external dependencies",
  "impact":"Pure reverse impact projection from supplied graph",
  "distributed_placement":"Explicit write-primary placements; no host selection",
  "distributed_publication":"External fencing, verification, staged UI and readback",
  "partial_failure":"Explain partial writes; no blind retry or compensation"
 },
 "provider_ports":[
  {"role":"graph","contract":"graph.snapshot.read","purpose":"external dependency and provenance readback"},
  {"role":"taskpool","contract":"tasks.work.claim","purpose":"external work leases and queue"},
  {"role":"capabilities","contract":"capability.resolve","purpose":"dynamic typed provider discovery"},
  {"role":"ui","contract":"ui.contribution.publish","purpose":"verified UI publication"},
  {"role":"diagnostics","contract":"diagnostic.incident.report","purpose":"explain incidents and remedies"},
  {"role":"remediation","contract":"remediation.attempt.safe","purpose":"authorized deterministic fixes"},
  {"role":"provenance","contract":"provenance.record.append","purpose":"immutable external audit"},
  {"role":"runtime","contract":"capability.invoke","purpose":"host-routed typed invocation"},
  {"role":"verification","contract":"verification.acceptance.evaluate","purpose":"independent acceptance evidence"},
  {"role":"graph-stage","contract":"graph.revision.stage","purpose":"external graph revision CAS staging"},
  {"role":"publication","contract":"publication.transaction.commit","purpose":"externally coordinated commit"},
  {"role":"graph-reverse","contract":"graph.reverse_dependencies.read","purpose":"external reverse dependency index"},
  {"role":"ui-revoke","contract":"ui.contribution.revoke","purpose":"external UI revoke"},
  {"role":"task-revisit","contract":"tasks.work.reconsider","purpose":"external revision-bound revisit"},
  {"role":"composition","contract":"graph.snapshot.read","purpose":"external composite topology snapshot"},
  {"role":"distributed-status","contract":"capability.status.read","purpose":"participant transaction readback"},
  {"role":"coordinator-status","contract":"publication.transaction.status","purpose":"external transaction journal"},
  {"role":"ui-stage","contract":"ui.contribution.stage","purpose":"stage verified Raw UI by revision"}
 ],
 "graph_node_kinds":["project","plugin","module","function","capability","task","revision","artifact","test","ui_contribution","blocker","remedy","execution","policy","host","composite"],
 "graph_edge_kinds":["contains","implements","provides","requires","depends_on","consumes","invokes","displayed_as","verified_by","blocked_by","remediated_by","invalidates","supersedes","executed_on","produces","derived_from","mounted_in"],
 "function_states":["proposed","validated","implemented","verified","published","invalidated"],
 "events":["contract.changed","dependency.changed","function.invalidated","function.published","function.verified","incident.detected","incident.remediation_attempted","permission.changed","provider.revoked","ui.contribution.changed","verification.failed","distribution.placement.changed","distribution.transaction.uncertain","distribution.recovery.required"],
 "adapter_actions":["forge.describe","forge.validate","forge.prepare","forge.compose","forge.publication.plan","forge.reconcile.prepare","forge.incident.validate","forge.providers.negotiate","forge.events.project","forge.integration.prepare","forge.visibility.assess","forge.composite.plan","forge.composite.impact","forge.distribution.plan","forge.distribution.recover"],
 "external_effects":false,
 "stores_state":false,
 "publication_phases":["intent","provider_resolution","typed_execution","independent_verification","stage_graph","stage_capability","stage_ui","atomic_commit","audit"],
 "graph_projections":{"topology":["plugin","module","function","capability"],"development":["task","function","test","artifact"],"execution":["function","execution","host","result"],"interface":["capability","ui_contribution","policy"],"diagnostics":["blocker","remedy","execution","test"]}
}
