{
  "mas": "1.0",
  "id": "chat_messages",
  "name": "Chat Messages",
  "version": "0.1.0",
  "icon": "editor",
  "lifecycle": "independent",
  "service": {
    "protocol": "mas-http-1",
    "port": 8922,
    "invokeTimeoutMs": 12000
  },
  "ui": {
    "standard": "mas-ui-1",
    "mode": "embedded-and-standalone"
  },
  "auth": {
    "mode": "host-delegated"
  },
  "permissions": [
    "chat.messages"
  ],
  "events": {
    "schema": "mas-event-1"
  },
  "data": {
    "refs": "mas-ref-1"
  },
  "updates": {
    "strategy": "semver",
    "migrations": []
  }
}
