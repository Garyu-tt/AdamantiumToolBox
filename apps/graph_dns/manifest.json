{
  "mas": "1.0",
  "id": "graph_dns",
  "name": "Graph DNS",
  "version": "0.1.0",
  "icon": "graph",
  "lifecycle": "independent",
  "service": {
    "protocol": "mas-http-1",
    "port": 8921,
    "invokeTimeoutMs": 5000
  },
  "ui": {
    "standard": "mas-ui-1",
    "mode": "embedded-and-standalone"
  },
  "auth": {
    "mode": "host-delegated"
  },
  "permissions": [
    "graph_dns.read"
  ],
  "events": {
    "schema": "mas-event-1"
  },
  "data": {
    "refs": "mas-ref-1"
  },
  "updates": {
    "strategy": "semver",
    "migrations": []
  },
  "connections": [
    {
      "from": "graph_dns.audit",
      "to": "network_inventory.reconcile",
      "type": "related"
    }
  ]
}
