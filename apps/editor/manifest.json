{
  "mas": "1.0",
  "id": "editor",
  "name": "Редактор",
  "version": "0.2.0",
  "icon": "editor",
  "lifecycle": "independent",
  "service": {
    "protocol": "mas-http-1",
    "port": 8881
  },
  "ui": {
    "standard": "mas-ui-1",
    "mode": "embedded-and-standalone"
  },
  "auth": {
    "mode": "host-delegated"
  },
  "permissions": [
    "workspace.read",
    "workspace.write"
  ],
  "events": {
    "schema": "mas-event-1"
  },
  "data": {
    "refs": "mas-ref-1"
  },
  "updates": {
    "strategy": "semver",
    "migrations": []
  },
  "connections": [
    {
      "from": "editor.view",
      "to": "studio.view",
      "type": "related"
    }
  ]
}
