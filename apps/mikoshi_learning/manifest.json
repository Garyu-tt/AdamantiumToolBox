{
  "mas": "1.0",
  "id": "mikoshi_learning",
  "name": "Mikoshi Learning",
  "version": "0.1.0",
  "icon": "studio",
  "lifecycle": "independent",
  "service": {
    "protocol": "mas-http-1",
    "port": 8923,
    "invokeTimeoutMs": 18000
  },
  "ui": {
    "standard": "mas-ui-1",
    "mode": "embedded-and-standalone"
  },
  "auth": {
    "mode": "host-delegated"
  },
  "permissions": [
    "learning.inspect",
    "learning.train"
  ],
  "events": {
    "schema": "mas-event-1"
  },
  "data": {
    "refs": "mas-ref-1"
  },
  "updates": {
    "strategy": "semver",
    "migrations": []
  }
}
