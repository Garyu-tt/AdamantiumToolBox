{
  "mas": "1.0",
  "id": "wireguard_graph",
  "name": "WireGuard Graph",
  "version": "0.1.0",
  "icon": "graph",
  "lifecycle": "independent",
  "service": {
    "protocol": "mas-http-1",
    "port": 8927,
    "invokeTimeoutMs": 5000
  },
  "ui": {
    "standard": "mas-ui-1",
    "mode": "embedded-and-standalone"
  },
  "auth": {
    "mode": "host-delegated"
  },
  "permissions": [
    "wireguard_graph.read"
  ],
  "events": {
    "schema": "mas-event-1"
  },
  "data": {
    "refs": "mas-ref-1"
  },
  "updates": {
    "strategy": "semver",
    "migrations": []
  },
  "connections": [
    {
      "from": "wireguard_graph.snapshot",
      "to": "network_inventory.snapshot",
      "type": "related"
    },
    {
      "from": "wireguard_graph.snapshot",
      "to": "graph_firewall.inspect",
      "type": "related"
    }
  ]
}
