{
  "mas": "1.0",
  "id": "factory_anchor",
  "name": "Factory Audit Anchor",
  "version": "0.1.0",
  "icon": "factory_anchor",
  "lifecycle": "independent",
  "service": {
    "protocol": "mas-http-1",
    "port": 8966,
    "invokeTimeoutMs": 10000
  },
  "ui": {
    "standard": "mas-ui-1",
    "mode": "embedded-and-standalone"
  },
  "auth": {
    "mode": "host-delegated"
  },
  "permissions": [
    "factory_anchor.read",
    "factory_anchor.attest"
  ],
  "events": {
    "schema": "mas-event-1"
  },
  "data": {
    "refs": "mas-ref-1"
  },
  "updates": {
    "strategy": "semver",
    "migrations": []
  }
}
